{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kapiloto Research Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "fixtures"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": [
        "kapiloto-research-v1"
      ]
    },
    "fixtures": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round_game_id",
          "outcome",
          "scores",
          "analysis_confidence",
          "summary",
          "main_risk",
          "factors",
          "data_quality",
          "watch_items"
        ],
        "properties": {
          "round_game_id": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "analyzed",
              "insufficient_data",
              "void",
              "carried_forward"
            ]
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "score_1",
              "score_x",
              "score_2"
            ],
            "properties": {
              "score_1": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "score_x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "score_2": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "analysis_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "summary": {
            "type": "string"
          },
          "main_risk": {
            "type": "string"
          },
          "factors": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "direction",
                "importance",
                "text",
                "source_urls"
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "current_form",
                    "home_away",
                    "availability",
                    "load_schedule",
                    "tactical_matchup",
                    "competition_context",
                    "team_news",
                    "market_signal",
                    "external_model",
                    "head_to_head",
                    "other"
                  ]
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "home",
                    "draw",
                    "away",
                    "neutral",
                    "risk"
                  ]
                },
                "importance": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "text": {
                  "type": "string"
                },
                "source_urls": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "data_quality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "coverage",
              "conflict_present",
              "missing_areas",
              "conflict_note"
            ],
            "properties": {
              "coverage": {
                "type": "string",
                "enum": [
                  "good",
                  "partial",
                  "poor"
                ]
              },
              "conflict_present": {
                "type": "boolean"
              },
              "missing_areas": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string"
                }
              },
              "conflict_note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "watch_items": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "enum": [
                "lineup",
                "injury",
                "suspension",
                "rotation",
                "odds_move",
                "kickoff_change",
                "postponement",
                "other"
              ]
            }
          }
        }
      }
    }
  }
}
