# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secrets
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_API_KEY=
SPORTMONKS_API_TOKEN=

# Local UI development only: "1" serves Kapiloto from an in-memory demo adapter
# under `next dev` (?kapiloto_demo=fresh|stale|shared|exhausted|error|rate_limited).
# Ignored in production builds; never set in deployed environments.
NEXT_PUBLIC_KAPILOTO_DEMO=

# Kapiloto AI research runtime (server only)
KAPILOTO_OPENAI_MODEL=
KAPILOTO_OPENAI_REASONING_EFFORT=high
KAPILOTO_MAX_ATTEMPTS_PER_TASK=3

# API-Football request pacing. Free-tier default is 6500 ms.
API_FOOTBALL_MIN_REQUEST_INTERVAL_MS=6500
