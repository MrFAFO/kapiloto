# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secrets
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_API_KEY=
SPORTMONKS_API_TOKEN=

# Local UI development only: "1" serves Kapiloto from an in-memory demo adapter
# under `next dev` (?kapiloto_demo=fresh|stale|shared|exhausted|error|rate_limited).
# Ignored in production builds; never set in deployed environments.
NEXT_PUBLIC_KAPILOTO_DEMO=

# Kapiloto model routing. Values are configured per environment.
KAPILOTO_RESEARCH_MODEL=
KAPILOTO_FAST_MODEL=
